                                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD"/>
                            </instance_material>
                            <instance_material symbol="material1" target="#material1">
                                <bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD"/>
                            </instance_material>
                        </technique_common>
                    </bind_material>
                </instance_geometry>
            </node>
        </visual_scene>
    </library_visual_scenes>
    <scene>
        <instance_visual_scene url="#VisualSceneNode"/>
    </scene>
</COLLADA>
