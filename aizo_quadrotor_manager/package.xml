<package format="2">
  <name>aizo_quadrotor_manager</name>
  <version>1.0.0</version>
  <description>
    High-level command interface for the AIZO quadrotor control stack.
    Provides ROS services for takeoff, landing, trajectory tracking, and velocity control.
  </description>
  <maintainer email="thanhnc@example.com">Thanh Nguyen</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>

  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>aizo_planning_msgs</depend>
  <depend>aizo_tracker_msgs</depend>
  <depend>std_srvs</depend>
  <depend>actionlib</depend>

  <exec_depend>message_runtime</exec_depend>

</package>
